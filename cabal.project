repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

index-state:
  , hackage.haskell.org 2026-09-02T14:05:07Z
  , cardano-haskell-packages 2026-10-09T14:30:01Z
active-repositories:
  , :rest
  , cardano-haskell-packages:override

packages:
  cardano-db
  cardano-db/test
  cardano-db-sync
  cardano-db-tool
  cardano-smash-server
  cardano-chain-gen

package cardano-chain-gen
  ghc-options: -Wall -Werror -Wredundant-constraints -Wincomplete-uni-patterns -Wincomplete-record-updates -Wpartial-fields -Wunused-imports -Wunused-packages

package cardano-db
  ghc-options: -Wall -Werror -Wredundant-constraints -Wincomplete-uni-patterns -Wincomplete-record-updates -Wpartial-fields -Wunused-imports -Wunused-packages

package cardano-db-sync
  ghc-options: -Wall -Werror -Wredundant-constraints -Wincomplete-uni-patterns -Wincomplete-record-updates -Wpartial-fields -Wunused-imports -Wunused-packages

package cardano-db-tool
  ghc-options: -Wall -Werror -Wredundant-constraints -Wincomplete-uni-patterns -Wincomplete-record-updates -Wpartial-fields -Wunused-imports -Wunused-packages

package cardano-smash-server
  ghc-options: -Wall -Werror -Wredundant-constraints -Wincomplete-uni-patterns -Wincomplete-record-updates -Wpartial-fields -Wunused-imports -Wunused-packages

package cardano-node
   -- We are using cardano-node as a library and we never use the systemd scribe, so there
   -- is no benefit to linking against it
   flags: -systemd

package postgresql-libpq
   flags: +use-pkg-config

package cryptonite
  -- Using RDRAND instead of /dev/urandom as an entropy source for key
  -- generation is dubious. Set the flag so we use /dev/urandom by default.
  flags: -support_rdrand

-- Do not depend on C++ for slightly faster utf8 parsing.
package text
  flags: -simdutf

-- ---------------------------------------------------------
-- Enable tests

-- Tests are disabled for the w41 build: global `tests: True` made haskell.nix
-- build the ledger SRP packages' test components, pulling a `cuddle` testlib that
-- fails to typecheck on ghc910 (the node never builds these). The db-sync binary
-- and the -linux dist need no test components.
tests: False
test-show-details: direct

-- Always write GHC env files, because they are needed for ghci.
write-ghc-environment-files: always

package snap-server
  -- This flag is only needed for a component of `cardano-node` and then
  -- only if the `cardano-node` is compiled with `+rtview`.
  flags: -openssl

-- ---------------------------------------------------------

constraints:
  -- The old `text < 2.1.2` cap is dropped: w41 cardano-keys requires text >=2.1.3
  -- and ghc910 boots text 2.1.3 (the node leaves text unconstrained).
  , hasql ==1.9.3
  -- w41 cardano-base moved the crypto closure to crypton 1.1 (`ram`); the earlier
  -- `crypton < 1.1` cap is gone, matching the node's w41 cabal.project.
  -- haskell.nix patch does not work for crypton-x509-system 1.6.8 (mirrors the node).
  , any.crypton-x509-system < 1.6.8 || >= 1.7
  -- cardano-rpc needs proto-lens 0.7.1.7+; haskell.nix would otherwise pin 0.7.1.5
  , any.proto-lens >= 0.7.1.7
  -- transformers-compat-0.8 breaks monad-control (needs <0.8); pin below it
  , transformers-compat < 0.8
  -- some-1.1 breaks dependent-sum (needs <1.0.7); pin below it
  , some < 1.0.7
  -- w41's byron-spec-chain/byron-spec-ledger now require microlens >=0.5, so the
  -- earlier `microlens < 0.5` cap is dropped (matches the node leaving it unconstrained).

allow-newer:
    , cardano-api:plutus-core
    , resource-registry:nothunks
    , ekg:network
    -- w41's ouroboros-network is 1.3.0.0 but ekg-forward 1.3 caps it <1.3; relax the
    -- upper bound (complements the existing allow-older for the lower bound).
    , ekg-forward:ouroboros-network
    -- cardano-api (leios w32 pin) still bounds cardano-crypto-class ^>=2.5, but the
    -- cardano-base SRP ships 2.6; relax as the node's cabal.project does.
    , cardano-crypto-class
    -- cardano-keys/cardano-config predate the cardano-ledger master the leios
    -- prototype is on (mirrors the node's w41 cabal.project).
    , cardano-keys:cardano-ledger-core
    , cardano-keys:cardano-ledger-shelley
    , cardano-keys:cardano-protocol
    , cardano-config:cardano-ledger-conway
    , cardano-config:cardano-ledger-core
    , cardano-config:cardano-ledger-dijkstra
    , cardano-config:cardano-ledger-shelley

allow-older:
    , cardano-ledger-binary:cuddle
    , cardano-ledger-binary:antigen
    , cardano-ledger-core:cuddle
    , cardano-ledger-core:antigen
    -- ekg-forward 1.3 requires ouroboros-network ^>=1.2 but the network SRP is
    -- still 1.1.0.0; relax as the node's cabal.project does.
    , ekg-forward:ouroboros-network

if impl (ghc >= 9.12)
  allow-newer:
    -- https://github.com/kapralVV/Unique/issues/11
    , Unique:hashable

    -- https://github.com/Gabriella439/Haskell-Pipes-Safe-Library/pull/70
    , pipes-safe:base

    , io-classes:time
    , ouroboros-network:time
    , nothunks:time
    , network-mux:time
    , cardano-ping:time


-- The two following one-liners will cut off / restore the remainder of this file (for nix-shell users):
-- when using the "cabal" wrapper script provided by nix-shell.
-- --------------------------- 8< --------------------------
-- Please do not put any `source-repository-package` clause above this line.

-- Leios (w32) ouroboros-consensus (LeiosDemoOnlyTestNotify) needs the lookahead
-- typed-protocols API (SenderVariability, runLookaheadFixedSenderPeerWithDriver,
-- PeerLookaheadFixedSender, Sender), only on this pin — not on CHaP. Matches the node.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/typed-protocols
  tag: 9b4627221ae5d649f2303c6926a8dba3f9934658
  --sha256: sha256-55skVYIR0WjXMwJEirLgF0HFHUpFLBppuV9gvTWqoOI=
  subdir:
    typed-protocols

-- Leios (w32+) pulls cardano-crypto-leios and a crypton-1.0-pinned cardano-crypto-class
-- from the cardano-base SRP (not yet on CHaP). Keep the subdir set the node pins.
source-repository-package
  type: git
  location: https://github.com/IntersectMBO/cardano-base
  tag: c1e1ed8d7ae39c111c73fc5f59ac37ce5933b83c
  --sha256: sha256-UawlVBgCkU8H6o1k8BHj6pRkZjbHsdVEVIBW0ZFpWkc=
  subdir:
    cardano-binary
    cardano-crypto-class
    cardano-crypto-leios
    cardano-crypto-praos

source-repository-package
