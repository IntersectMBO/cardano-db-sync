-- Fork with iohk-monitoring + tracer-transformers ported to contra-tracer 0.2.
-- Do NOT include the bundled contra-tracer subdir (still on 0.1.x); CHaP's
-- contra-tracer 0.2 is used instead.
source-repository-package
  type: git
  location: https://github.com/kderme/iohk-monitoring-framework.git
  tag: b6e1d40e1c85a15fbd1351f113ab5ba95da19f73
  --sha256: sha256-UuKIbcahBfOpSNSUDTNEcwTcMiYZSynmDytr3lb2ycA=
  subdir:
    iohk-monitoring
    tracer-transformers

-- CHaP's ekg-forward-1.2 is too old for the newer ouroboros-network
-- ConnectToArgs API; use the exact fork+commit the w32 node pins (it moved from
-- f-f to input-output-hk in w32).
source-repository-package
  type: git
  location: https://github.com/input-output-hk/ekg-forward
  tag: 85470ae7e8fac9711682234ed39a36eec3d45a9b
  --sha256: sha256-yk67GraJUsFi5mSETnaeuKNSnNRLOri6FK5yzmRLzxU=

